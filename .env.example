# Copy this file to .env.local and fill in the values.
# The same variables must also be set in the Vercel project settings —
# NEXT_PUBLIC_* values are inlined at build time, so changing them there
# requires a redeploy to take effect.

# PostHog — Settings > Project > Project API Key (starts with phc_)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# The INGEST host, not the dashboard URL: https://us.i.posthog.com or
# https://eu.i.posthog.com. next.config.ts derives the assets host from it.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# EmailJS — dashboard.emailjs.com. The template must declare exactly:
#   {{from_name}} {{from_email}} {{message}} {{time}} {{to_email}}
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
